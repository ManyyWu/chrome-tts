{
  "name": "chrome-tts",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/settings.ts src/background/service-worker.ts src/content/content-script.ts --bundle --format=iife --target=chrome127 --outbase=src --outdir=dist",
    "check": "tsc --noEmit",
    "watch": "esbuild src/settings.ts src/background/service-worker.ts src/content/content-script.ts --bundle --format=iife --target=chrome127 --outbase=src --outdir=dist --watch"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.36",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  }
}
